# ============================================================
# Production 환경 (Oracle ARM + Vercel + DuckDNS + Caddy)
# ============================================================
# 사용법:
#   1. Oracle ARM SSH 후: cp envs/example.prod.env envs/.prod.env
#   2. envs/.prod.env 에서 CHANGE_THIS_* 항목을 실제 값으로 입력
#   3. cp envs/.prod.env .env (docker-compose 가 .env 로 읽음)
#   4. Vercel: Dashboard 에서 NEXT_PUBLIC_* 변수 설정 (아래 섹션 참조)
# ============================================================

# 환경
ENV=prod
NEXT_PUBLIC_ENV=prod

# 보안 (필수! 실제 값으로 변경)
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_64_CHAR_RANDOM_STRING
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# 카카오 (필수! 실제 값으로 변경)
KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET

# DB & Redis (Oracle ARM self-host — docker-compose 내부 호스트명)
DB_HOST=postgres
DB_PORT=5432
DB_USER=doseph_admin
DB_NAME=doseph_db
REDIS_URL=redis://redis:6379/0

# CORS — Vercel 도메인 명시 허용 (FastAPI CORSMiddleware 가 읽음).
# 다중 도메인은 콤마(,) 구분. preview 도메인 묶으려면 정규식 패턴 권장.
ALLOWED_ORIGINS=https://CHANGE_THIS_VERCEL_PROJECT.vercel.app

# 도메인 (Caddy server_name + Let's Encrypt 인증서 발급 도메인)
# DuckDNS 가입 후 hostname 신청 → Oracle ARM Reserve Public IP 매핑.
DOMAIN=doseph.duckdns.org

# DuckDNS 자동 갱신 (Oracle ARM cron 5분 주기로 호출)
# DUCKDNS_TOKEN=CHANGE_THIS_DUCKDNS_TOKEN

# AI Worker (선택)
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET_KEY=
# OPENAI_API_KEY=

# 파일 로그 디렉토리 (RotatingFileHandler) — 컨테이너 내부 경로.
# 호스트 ~/Doseph/logs/<service> 로 volume 마운트. 매 deploy 시작 시
# logs.prev.tar.gz 로 한 세대 백업 후 logs/ 새로 생성 — 라이프사이클 관리는
# .github/workflows/deploy.yml 에서 처리.
LOG_DIR=/app/logs

# ============================================================
# Vercel 환경변수 (Dashboard > Settings > Environment Variables)
# ============================================================
# NEXT_PUBLIC_ENV=prod
# NEXT_PUBLIC_API_BASE_URL=https://doseph.duckdns.org
# NEXT_PUBLIC_KAKAO_CLIENT_ID=<카카오 REST API 키>
