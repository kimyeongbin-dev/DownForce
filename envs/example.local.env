# ============================================================
# 로컬 환경 (local / dev)
# ============================================================
# 사용법: cp envs/example.local.env .env
#
# local: dev 로그인 버튼 O (빠른 개발)
# dev:   dev 로그인 버튼 X (카카오 테스트)
# ============================================================

# 환경 (local 또는 dev)
ENV=local
NEXT_PUBLIC_ENV=local

# 보안 (로컬용)
SECRET_KEY=local-dev-secret-key-change-in-production
DB_PASSWORD=pw1234

# 카카오 (local: mock 사용, dev: 실제 키 입력)
KAKAO_CLIENT_ID=mock_kakao_client_id
KAKAO_CLIENT_SECRET=mock_kakao_client_secret

# DB & Redis (Docker Compose)
DB_HOST=postgres
DB_PORT=5432
DB_USER=doseph_admin
DB_NAME=doseph_db
REDIS_URL=redis://redis:6379/0

# Public Data API (data.go.kr)
DATA_GO_KR_API_KEY=your_api_key_here

# 파일 로그 디렉토리 (RotatingFileHandler) — 컨테이너 내부 경로.
# docker-compose 가 ./logs/<service> 호스트 폴더로 volume 마운트.
LOG_DIR=/app/logs
