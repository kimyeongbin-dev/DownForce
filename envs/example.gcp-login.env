# ============================================================
# GCP e2-micro "로그인까지" 배포 (docker-compose.gcp-login.yml 용)
# ============================================================
# 사용법 (VM SSH):
#   1. cp envs/example.gcp-login.env .env
#   2. .env 에서 CHANGE_THIS_* 를 실제 값으로 채움
#   3. docker compose -f docker-compose.gcp-login.yml up -d --build
# 주의: .env 는 절대 커밋 금지(비밀값 포함). 이 example 파일만 커밋.
# ============================================================

# 환경
ENV=prod

# 보안 (필수! 실제 값으로 변경)
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_64_CHAR_RANDOM_STRING

# DB — Neon (Postgres, TLS 필수)
# DB_SSL=true 여야 asyncpg 가 Neon 에 TLS 로 연결됨.
DB_HOST=CHANGE_THIS_NEON_POOLER_HOST   # 예: ep-xxxx-pooler.<region>.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_NAME=Doseph
DB_PASSWORD=CHANGE_THIS_NEON_PASSWORD
DB_SSL=true

# 카카오 OAuth (필수! 실제 REST 키로 변경)
KAKAO_CLIENT_ID=CHANGE_THIS_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=CHANGE_THIS_KAKAO_CLIENT_SECRET

# URL / 도메인 — FE 와 API 는 같은 등록가능도메인(doseph.com) = same-site 쿠키.
API_BASE_URL=https://api.doseph.com
FRONTEND_URL=https://doseph.com
KAKAO_REDIRECT_URI=https://doseph.com/auth/kakao/callback
# COOKIE_DOMAIN 미설정 → host-only(api.doseph.com). SameSite=Lax 로 same-site 전송됨.

# Cloudflare Tunnel 토큰 (Zero Trust 대시보드에서 터널 생성 시 발급)
TUNNEL_TOKEN=CHANGE_THIS_CLOUDFLARE_TUNNEL_TOKEN

# 로그 디렉토리 (컨테이너 내부)
LOG_DIR=/app/logs
